				(size 1.1 1.1)
			)
		)
		(uuid "12b56045-f7ca-432b-88c1-1d7fab2368c7")
	)
	(text "GPIO0 has only a 10k pull-up and BOOT switch. GPIO2 LED is active-high and not externally pulled."
