	(text "PCB-A CONTROLLER — KiCad 9 reference schematic; NOT fabrication-ready"
		(exclude_from_sim no)
		(at 20 15 0.0000)
		(effects
			(font
				(size 1.5 1.5)
			)
		)
		(uuid "08bb25f8-a697-4ad9-976f-3c18d7a8e31a")
	)
	(text "Power ownership: PCB-B supplies one protected +12V rail. UART header is 3V3 logic/reference only; never back-power PCB-A."
		(exclude_from_sim no)
		(at 20 20 0.0000)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "9eb53906-1b1f-411e-b6e4-1ec7f5e0fc91")
	)
	(text "Analog A0-A3: 0..5V nominal, divided to 0..3V. No negative/transient protection; externally condition and verify before use."
		(exclude_from_sim no)
		(at 20 25 0.0000)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "692c6df8-b112-4033-a405-46dc429b690b")
	)
	(text "INTERBOARD: 1=+12V protected; 2,11,12=GND; 3..10=OUT1..OUT8. Logic only—no load current."
		(exclude_from_sim no)
		(at 15 92 0.0000)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "5c2e22eb-74b1-4c1f-99cc-04c903a61588")
	)
	(text "TPS5430: 5V reference network per TI datasheet; verify L/C ESR, compensation behavior and thermal design."
		(exclude_from_sim no)
		(at 45 69 0.0000)
		(effects
