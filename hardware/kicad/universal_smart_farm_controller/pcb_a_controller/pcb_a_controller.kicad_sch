		(at 35 151 0.0000)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "8e2ae0b0-693b-45c0-a3d1-600317b683e3")
	)
	(text "J2 DS18B20: 1=3V3 2=DATA 3=GND. J3 DHT22 bare sensor: 1=3V3 2=DATA 3=NC 4=GND."
		(exclude_from_sim no)
		(at 125 115 0.0000)
