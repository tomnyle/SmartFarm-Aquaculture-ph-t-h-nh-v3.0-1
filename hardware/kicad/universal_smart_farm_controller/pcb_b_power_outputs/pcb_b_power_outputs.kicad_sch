	(text "PCB-B 12V DC POWER & OUTPUTS — KiCad 9 reference schematic; NOT fabrication-ready"
		(exclude_from_sim no)
		(at 20 15 0.0000)
		(effects
			(font
				(size 1.5 1.5)
			)
		)
		(uuid "8188bb23-cad0-4d72-88f9-1d2083913fdd")
	)
	(text "12V DC ONLY. Never route mains. PCB-B owns the only supply input and sends protected 12V + logic ground to PCB-A."
		(exclude_from_sim no)
		(at 20 20 0.0000)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "eb9d9dab-a11f-4420-9732-f989c270c490")
	)
	(text "Output ratings are provisional: size fuses, copper, connectors, MOSFETs and diodes from measured continuous/stall/inrush current."
		(exclude_from_sim no)
		(at 20 25 0.0000)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "9a95ec4a-dcd5-4d71-a283-caaca0cf491f")
	)
	(text "D0 series SS54 blocks reverse polarity (loss/thermal limits apply). D1 unidirectional TVS: cathode pin 1 to +12V, anode pin 2 to GND."
		(exclude_from_sim no)
		(at 25 67 0.0000)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "ded790e0-df90-4b08-8674-0c684201bfad")
	)
	(text "INTERBOARD JB mates JA 1:1: pin 1 protected +12V; 2,11,12 GND; pins 3..10 OUT1..OUT8 control."
		(exclude_from_sim no)
		(at 130 80 0.0000)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "46cb7f0e-7563-469e-990a-28f8edcdd209")
	)
	(text "Use multiple ground pins for logic/reference return only. Route load return directly to input ground plane/star; never through header."
